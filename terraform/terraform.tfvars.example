aws_region     = "ap-south-1"
project_name   = "aws-devops-platform"
environment    = "dev"
cluster_version = "1.33"

# IMPORTANT: Replace with your current trusted public IP /32 before terraform apply.
# The example address below is documentation-only and will not permit your connection.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

node_instance_types = ["t3.medium"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3
